# ===== AgentSociety² LLM 配置（复制本文件为 .env 并填入真实值）=====
# 重要：.env 已被 .gitignore 忽略，切勿提交真实密钥！

# 必填：主 LLM 的 API Key
AGENTSOCIETY_LLM_API_KEY=sk-your-key-here

# 必填（或与你的服务商一致）：API Base URL（OpenAI 兼容）
# 例如 OpenAI: https://api.openai.com/v1
# 例如 深度求索: https://api.deepseek.com/v1
# 例如 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
AGENTSOCIETY_LLM_API_BASE=https://api.openai.com/v1

# 必填：默认模型名（需与上面的 base 对应）
AGENTSOCIETY_LLM_MODEL=gpt-4o

# 可选：代码生成角色（回退到 LLM_*）
# AGENTSOCIETY_CODER_LLM_API_KEY=
# AGENTSOCIETY_CODER_LLM_API_BASE=
# AGENTSOCIETY_CODER_LLM_MODEL=

# 可选：高频操作角色（回退到 LLM_*）
# 注意：ReAct 决策走 NANO 档，若你的服务商不识别平台默认模型名（如 gpt-5.4-nano），
# 请显式设成与你 AGENTSOCIETY_LLM_MODEL 相同的模型名，否则智能体 LLM 决策会失败。
# AGENTSOCIETY_NANO_LLM_API_KEY=
# AGENTSOCIETY_NANO_LLM_API_BASE=
# AGENTSOCIETY_NANO_LLM_MODEL=

# 可选：分析角色（回退到 LLM_*）
# AGENTSOCIETY_ANALYSIS_LLM_API_KEY=
# AGENTSOCIETY_ANALYSIS_LLM_API_BASE=
# AGENTSOCIETY_ANALYSIS_LLM_MODEL=
